Drop the optional serde-pyobject dependency.

serde-pyobject is declared as an optional dependency and pulled in by the
"python-bindings" feature, but it is never referenced anywhere in the source
(no `use serde_pyobject`, no `serde_pyobject::` calls). Fedora does not package
it. Because `cargo metadata` (run by maturin during the build) resolves every
optional dependency regardless of which features are enabled, the crate has to
be removed from the manifest entirely, not merely left disabled.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -13,7 +13,6 @@
 thiserror = "2.0"
 pyo3 = { version = "0.27", features = ["extension-module"], optional = true }
 regex = "1.10.6"
-serde-pyobject = { version = "0.8.0", optional = true }
 serde_json = { version = "1.0", features = ["preserve_order"] }
 serde = {version = "1.0", features = ["derive"]}
 bincode = "2.0.1"
@@ -34,7 +33,7 @@
 
 [features]
 default = ["hugginface-hub"]
-python-bindings = ["pyo3", "pyo3/generate-import-lib", "serde-pyobject"]
+python-bindings = ["pyo3", "pyo3/generate-import-lib"]
 hugginface-hub = ["hf-hub", "tokenizers/http",  "tokenizers/rustls-tls"]
 
 [lib]
